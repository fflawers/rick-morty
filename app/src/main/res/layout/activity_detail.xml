<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado"
    > <!-- Fondo oscuro -->

    <!-- Foto Grande del personaje -->
    <ImageView
        android:id="@+id/ivDetailPhoto"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:layout_marginTop="85dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Botón de regreso -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:background="#000000"
        android:contentDescription="Boton de regresar"
        android:src="@drawable/ic_flecha_regreso"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Nombre Grande de cada personaje -->
    <TextView
        android:id="@+id/tvDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/ivDetailPhoto"/>

    <!-- Estado y Especie -->
    <TextView
        android:id="@+id/tvDetailStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textColor="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/tvDetailName"/>

    <!-- Origen-->
    <TextView
        android:id="@+id/Origintxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textColor="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/tvDetailStatus"/>

    <!-- Locacion -->
    <TextView
        android:id="@+id/locationtxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textColor="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/Origintxt"/>

    <!-- Episodios donde sale el wey -->
    <TextView
        android:id="@+id/episodeslisttxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textColor="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/locationtxt"/>

</androidx.constraintlayout.widget.ConstraintLayout>
